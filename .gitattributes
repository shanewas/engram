* text=auto
*.sh text eol=lf
*.ps1 text eol=crlf
# Memory paths union-merge: same-line edits on two machines keep both lines
# instead of blocking the node (docs/sync-contract.md §3). Consolidate dedupes.
index.md merge=union
projects/** merge=union
global/** merge=union
inbox/** merge=union
archive/** merge=union
