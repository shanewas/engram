#!/usr/bin/env bash
# engram — launcher for scripts/engram_cli.py, the one CLI engine (verbs are
# documented in its docstring and in README.md "Daily Commands").
#
# Resolve repo root: $ENGRAM_HOME, else the repo this script lives in, else ~/engram.
set -u

_resolve_root() {
  if [ -n "${ENGRAM_HOME:-}" ] && [ -d "$ENGRAM_HOME/.git" ]; then echo "$ENGRAM_HOME"; return; fi
  local self; self="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." 2>/dev/null && pwd)"
  if [ -d "$self/.git" ]; then echo "$self"; return; fi
  if [ -d "$HOME/engram/.git" ]; then echo "$HOME/engram"; return; fi
  echo ""; return 1
}
ROOT="$(_resolve_root)" || { echo "engram: no repo found (set ENGRAM_HOME or clone to ~/engram)" >&2; exit 1; }
export ENGRAM_HOME="$ROOT"   # engram_cli.py resolves its root from this; keep both on the same repo

for py in python3 python; do
  if command -v "$py" >/dev/null 2>&1; then
    exec "$py" -X utf8 "$ROOT/scripts/engram_cli.py" "$@"
  fi
done
echo "engram: python 3.8+ is required (same requirement as scripts/install.sh)" >&2
exit 1
