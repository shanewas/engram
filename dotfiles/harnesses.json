{
  "claude": {
    "name": "Claude Code",
    "binaries": ["claude", "claude.exe"],
    "config_dir": "{{HOME}}/.claude",
    "memory_file": "{{HOME}}/.claude/CLAUDE.md",
    "memory_import": "@{{ENGRAM_HOME_FWD}}/index.md",
    "skills_dir": "{{HOME}}/.claude/skills",
    "mcp_file": "{{HOME}}/.claude.json",
    "mcp_key": "mcpServers",
    "mcp_format": "claude"
  },
  "antigravity": {
    "name": "Antigravity (agy)",
    "binaries": ["agy", "agy.exe"],
    "config_dir": "{{HOME}}/.gemini",
    "memory_file": "{{HOME}}/.gemini/rules/engram.md",
    "skills_dir": "{{HOME}}/.gemini/config/skills",
    "mcp_file": "{{HOME}}/.gemini/config/mcp_config.json",
    "mcp_key": "mcpServers",
    "mcp_format": "antigravity"
  },
  "opencode": {
    "name": "OpenCode",
    "binaries": ["opencode", "opencode.ps1", "opencode.cmd"],
    "config_dir": "{{HOME}}/.config/opencode",
    "memory_file": "{{HOME}}/.config/opencode/instructions.md",
    "skills_dir": "{{HOME}}/.config/opencode/skills",
    "mcp_file": "{{HOME}}/.config/opencode/opencode.jsonc",
    "mcp_key": "mcp",
    "mcp_format": "opencode"
  },
  "muse": {
    "name": "Muse",
    "binaries": ["muse", "muse.cmd"],
    "config_dir": "{{HOME}}/.muse",
    "memory_file": "{{HOME}}/.muse/instructions.md",
    "skills_dir": "{{HOME}}/.muse/skills",
    "mcp_file": "{{HOME}}/.muse/config.json",
    "mcp_key": "mcpServers",
    "mcp_format": "claude"
  },
  "hermes": {
    "name": "Hermes Bridge",
    "config_dir": "{{ENGRAM_HOME}}/vault",
    "vault_path": "{{HOME}}/Documents/Obsidian Vault",
    "type": "bridge"
  }
}
